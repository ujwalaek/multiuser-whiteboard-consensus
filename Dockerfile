# One replica per container: scripts/docker_cluster.sh builds this image and starts a cluster.
FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/replica ./cmd/replica

FROM debian:bookworm-slim
# iproute2 for tc netem: real network delay and loss on the container's interface
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/replica /app/replica
COPY web /app/web
# this run's keys, generated by docker_cluster.sh just before the build
COPY keys /app/keys
ENTRYPOINT ["/app/replica"]
